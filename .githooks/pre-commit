#!/bin/bash
set -e

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

BUILD_DIR="build-linux"
export VCPKG_ROOT="${VCPKG_ROOT:-$HOME/vcpkg}"
export VULKAN_SDK="${VULKAN_SDK:-$HOME/.local/vulkan-sdk/1.4.350.1/x86_64}"
export LD_LIBRARY_PATH="$VULKAN_SDK/lib/VulkanLoader/lib:$LD_LIBRARY_PATH"
export VK_ADD_LAYER_PATH="$VULKAN_SDK/share/vulkan/explicit_layer.d"

echo -e "${GREEN}[pre-commit] Checking staged files...${NC}"

# === Step 1: clang-format 检查 ===
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(h|cpp|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "[pre-commit] No C++ files staged, skipping format check."
else
    echo "[pre-commit] Running clang-format on staged C++ files..."
    FORMAT_ERRORS=0
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            if ! clang-format --dry-run -Werror "$file" 2>&1; then
                echo -e "${RED}[pre-commit] Format error in: $file${NC}"
                echo "  Fix: clang-format -i $file"
                FORMAT_ERRORS=1
            fi
        fi
    done
    if [ "$FORMAT_ERRORS" -ne 0 ]; then
        echo -e "${RED}[pre-commit] Commit rejected: fix formatting and try again.${NC}"
        exit 1
    fi
fi

# === Step 2: 编译 ===
echo "[pre-commit] Configuring CMake..."
cmake -S . -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" \
    -DBUILD_TESTING=ON > /dev/null 2>&1

echo "[pre-commit] Building..."
if ! cmake --build "$BUILD_DIR" 2>&1 | tail -20; then
    echo -e "${RED}[pre-commit] Commit rejected: build failed.${NC}"
    exit 1
fi

# === Step 3: 测试 ===
echo "[pre-commit] Running tests..."
if ! ctest --test-dir "$BUILD_DIR" --output-on-failure 2>&1; then
    echo -e "${RED}[pre-commit] Commit rejected: tests failed.${NC}"
    exit 1
fi

echo -e "${GREEN}[pre-commit] All checks passed.${NC}"
